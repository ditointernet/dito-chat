#!groovy​

def labelUUID = "mypod-${UUID.randomUUID().toString()}"

podTemplate(label: labelUUID, containers: [
  containerTemplate(name: 'docker', image: 'docker', command: 'cat', ttyEnabled: true),
  containerTemplate(name: 'kubectl', image: 'lachlanevenson/k8s-kubectl', command: 'cat', ttyEnabled: true),
],
volumes: [
  hostPathVolume(mountPath: '/var/run/docker.sock', hostPath: '/var/run/docker.sock')
]) {

    node(labelUUID) {

        def DOCKER_HOST_NAME = 'registry.kubelab.info:30500'
        def DOCKER_IMAGE_NAME = 'frontend'
        def DOCKER_IMAGE_NAME_TEST = "frontend_test"      

        def dockerClean

        stage('Checkout') {
            checkout scm

            dockerClean = {
              sh ("docker stop ${DOCKER_IMAGE_NAME_TEST} || true")
              sh ("docker rm ${DOCKER_IMAGE_NAME_TEST} -f || true")
            }
        }

        stage('Build') {
            container('docker') {
                sh ("docker login ${DOCKER_HOST_NAME} --username admin -p 123456")
                sh ("docker build -t ${DOCKER_IMAGE_NAME}:latest .")
            }
        }

        stage('Test') {
            container('docker') {
                dockerClean()
                sh ("docker run -d -p 8889:3000 --name ${DOCKER_IMAGE_NAME_TEST} ${DOCKER_IMAGE_NAME}:latest")
                sh ("sleep 10")
                sh ("docker run --network container:${DOCKER_IMAGE_NAME_TEST} appropriate/curl --retry 10 --retry-connrefused -v -I -X GET http://192.168.15.150:8889/health.html | grep '200 OK'")
                dockerClean()
            }
        }

        stage('Push') {
            container('docker') {
                sh ("docker tag ${DOCKER_IMAGE_NAME}:latest ${DOCKER_HOST_NAME}/${DOCKER_IMAGE_NAME}:latest")
                sh ("docker tag ${DOCKER_IMAGE_NAME}:latest ${DOCKER_HOST_NAME}/${DOCKER_IMAGE_NAME}:v1.0.0.${env.BUILD_NUMBER}")
                sh ("docker push ${DOCKER_HOST_NAME}/${DOCKER_IMAGE_NAME}:v1.0.0.${env.BUILD_NUMBER}")
                sh ("docker push ${DOCKER_HOST_NAME}/${DOCKER_IMAGE_NAME}:latest")
            }
        }

        stage('Deploy') {

            sh("sed 's+DOCKER_HOST_NAME+${DOCKER_HOST_NAME}+g' k8s.yaml > patched_k8s.yaml")

            kubernetesDeploy(kubeconfigId: '86c50d3f-1a87-4bc1-8cb2-b89855779468',  

                configs: 'patched_k8s.yaml', 
                enableConfigSubstitution: true,
        
                secretNamespace: 'default',
                dockerCredentials: [
                        [credentialsId: '12e382d3-4258-4ad3-be10-37c7e59339b8', url: "https://${DOCKER_HOST_NAME}"],
                ]
            )

            // container('kubectl') {
            //     sh ("kubectl -n default rollout status deployment/${DOCKER_IMAGE_NAME}")
            // }
        }        
    }

}