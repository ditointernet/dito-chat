
#build stage
FROM golang:1.12 AS builder
WORKDIR /go/src/dito/backend
COPY . .
RUN go get -d -v ./...
RUN GO111MODULE=on CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o backend .

#final stage
FROM alpine:latest
LABEL Name="Dito Backend" Version=0.0.1
RUN apk --no-cache add ca-certificates
WORKDIR /dito/backend
COPY --from=builder /go/bin/dito/backend .
EXPOSE 8080
CMD ./backend
